
from sklearn.preprocessing import StandardScaler
from sklearn.decomposition import PCA
from hmmlearn.hmm import GaussianHMM
from pygam import LinearGAM, s
import numpy as np
import pandas as pd

def dwell_times_dict(seq):
    out = {}
    if len(seq) == 0:
        return out
    cur = seq[0]
    run = 1
    for x in seq[1:]:
        if x == cur:
            run += 1
        else:
            out.setdefault(cur, []).append(run)
            cur = x
            run = 1
    out.setdefault(cur, []).append(run)
    return out

def trans_counts_from_seq(seq, k):
    M = np.zeros((k, k), dtype=float)
    for a, b in zip(seq[:-1], seq[1:]):
        M[a, b] += 1.0
    return M

def weighted_transition_entropy(M, k, eps=1e-12):
    row_sums = M.sum(axis=1, keepdims=True)
    total = row_sums.sum()
    if total == 0:
        return 0.0

    P = np.divide(M, row_sums, out=np.zeros_like(M), where=row_sums > 0)
    P = np.clip(P, eps, 1.0)

    row_H = -(P * np.log(P)).sum(axis=1) / np.log(k)
    weights = row_sums[:, 0] / total
    return np.sum(weights * row_H)

def compute_subject_hmm_features(states_seq, k):
    # FO from hard states
    FO = np.bincount(states_seq, minlength=k) / len(states_seq)

    # dwell time
    dt_dict = dwell_times_dict(states_seq)
    DT = np.zeros(k, dtype=float)
    for s in range(k):
        runs = dt_dict.get(s, [])
        DT[s] = np.mean(runs) if len(runs) > 0 else 0.0

    # transition entropy
    M = trans_counts_from_seq(states_seq, k)
    ent = weighted_transition_entropy(M, k)

    # switch rate
    switch_rate = np.mean(states_seq[1:] != states_seq[:-1]) if len(states_seq) > 1 else 0.0

    return FO, DT, ent, switch_rate, M

def extract_fold_hmm_features(
    all_fc_z, groups, train_idx, test_idx,
    n_pca=50, n_states=4, random_state=0,
    hmm_covariance_type="diag",
    hmm_n_iter=500,
    hmm_tol=1e-3):

    N, W, E = all_fc_z.shape

    train_idx = np.asarray(train_idx)
    test_idx = np.asarray(test_idx)

    assert len(set(train_idx).intersection(set(test_idx))) == 0, "train/test overlap!"

    # training CN only
    cn_train_idx = train_idx[groups[train_idx] == "CN"]
    if len(cn_train_idx) == 0:
        raise ValueError("No CN subjects in training fold.")

    # 1) scaler on training CN only
    X_cn_train = all_fc_z[cn_train_idx].reshape(-1, E)
    scaler = StandardScaler().fit(X_cn_train)

    # 2) PCA on training CN only
    X_cn_train_sc = scaler.transform(X_cn_train)
    pca = PCA(n_components=n_pca, random_state=random_state).fit(X_cn_train_sc)

    # 3) transform all subjects in this fold
    fold_idx = np.concatenate([train_idx, test_idx])
    X_fold = all_fc_z[fold_idx].reshape(-1, E)
    X_fold_sc = scaler.transform(X_fold)
    Z_fold = pca.transform(X_fold_sc).reshape(len(fold_idx), W, n_pca)

    # 4) fit HMM on training CN only
    X_cn_hmm_sc = scaler.transform(all_fc_z[cn_train_idx].reshape(-1, E))
    Z_cn_hmm = pca.transform(X_cn_hmm_sc)
    lengths_cn = [W] * len(cn_train_idx)

    hmm = GaussianHMM(
        n_components=n_states,
        covariance_type=hmm_covariance_type,
        n_iter=hmm_n_iter,
        tol=hmm_tol,
        random_state=random_state,
        verbose=False
    )
    hmm.fit(Z_cn_hmm, lengths_cn)

    # 5) infer hard states for all subjects in fold
    Z_fold_concat = Z_fold.reshape(-1, n_pca)
    lengths_fold = [W] * len(fold_idx)
    states_fold = hmm.predict(Z_fold_concat, lengths_fold).reshape(len(fold_idx), W)

    # 6) compute subject-level features from hard states
    train_set = set(train_idx)
    rows = []
    A_all = []

    for i, subj in enumerate(fold_idx):
        FO, DT, ent, sw, A = compute_subject_hmm_features(
            states_fold[i], n_states
        )
        row = {
            "subject_index": subj,
            "group": groups[subj],
            "is_train": subj in train_set,
            "entropy": ent,
            "switch_rate": sw
        }
        for s in range(n_states):
            row[f"FO_{s}"] = FO[s]
            row[f"DT_{s}"] = DT[s]

        rows.append(row)
        A_all.append(A)

    feat_df_fold = pd.DataFrame(rows)
    A_all = np.asarray(A_all)

    models = {
        "scaler": scaler,
        "pca": pca,
        "hmm": hmm,
        "A_all": A_all
    }
    return feat_df_fold, models

def add_normative_entropy_deviation(feat_df_fold, ages, train_idx):
    feat_df_fold = feat_df_fold.copy()
    feat_df_fold["age"] = feat_df_fold["subject_index"].map(lambda i: float(ages[i]))

    train_cn_mask = feat_df_fold["subject_index"].isin(train_idx) & (feat_df_fold["group"] == "CN")
    df_cn = feat_df_fold.loc[train_cn_mask, ["age", "entropy"]].dropna().copy()

    if len(df_cn) < 10:
        raise ValueError("Too few training CN samples for GAM.")

    X_cn = df_cn[["age"]].values
    y_cn = df_cn["entropy"].values

    gam = LinearGAM(s(0, n_splines=min(10, max(4, len(df_cn)//5)))).gridsearch(X_cn, y_cn, progress=False)

    X_all = feat_df_fold[["age"]].values
    feat_df_fold["entropy_expected_cn"] = gam.predict(X_all)
    feat_df_fold["dyn_dev_signed"] = feat_df_fold["entropy"] - feat_df_fold["entropy_expected_cn"]
    feat_df_fold["dyn_dev_abs"] = np.abs(feat_df_fold["dyn_dev_signed"])

    return feat_df_fold, gam
